#ifndef INC_CONTROLLER_H_
#define INC_CONTROLLER_H_

#include <stdint.h>
#include <stddef.h>
#include "main.h"
//
// ==== Sensor Calibration Structures ====
//
typedef struct {
    int8_t  dig_x1, dig_y1, dig_x2, dig_y2;
    uint16_t dig_z1;
    int16_t dig_z2, dig_z3, dig_z4;
    uint16_t dig_xyz1;
    int8_t  dig_xy2, dig_xy1;
} BMM150_TrimData;

typedef struct {
    float par_t1, par_t2, par_t3;
    float par_p1, par_p2, par_p3, par_p4, par_p5, par_p6;
    float par_p7, par_p8, par_p9, par_p10, par_p11;
} BMP388_Calib;

//
// ==== Sensor Data Structures ====
//
typedef struct {
    uint8_t *buf;
    size_t len;
    BMM150_TrimData *trim;
    float mag_x, mag_y, mag_z;
    float gyro_x, gyro_y, gyro_z;
    float accel_x, accel_y, accel_z;
    float rhall;
} BMX160_t;

typedef struct {
    uint8_t *buf;
    size_t len;
    BMP388_Calib calib;
    float pressure;
    float temperature;
} BMP388_t;

typedef struct {
    uint32_t ccr[5];
    float width_us[5];
} PWM_out_t;

//
// ==== BODY DOF (6 Degrees of Freedom) ====
//
typedef struct { float *x, *y, *z; } Axis3f_t;

typedef union {
    struct { float *phi, *theta, *gamma; };
    struct { float *x, *y, *z; };
} AngularUnion_t;

typedef union {
    struct { float phi, theta, gamma; };
    struct { float x, y, z; };
} AngleUnion_t;

typedef struct {
    Axis3f_t acceleration;
    AngleUnion_t angle;
    AngularUnion_t angular_rate;
} BODY_t;
//
// ==== WORLD DOF (6 Degrees of Freedom) ====
//
typedef struct {
    float accele_convert[9];
    float angular_convert[9];
} RotationMatrix_t;  // giống Axis3f_t nhưng không phải con trỏ

typedef struct {
    float x, y, z;
} Axis3fVal_t;  // giống Axis3f_t nhưng không phải con trỏ

typedef union {
    struct { float phi, theta, gamma; };
    struct { float x, y, z; };
} AngularValUnion_t; // giống AngularUnion_t nhưng dùng giá trị float

typedef union {
    struct { float phi, theta, gamma; };
    struct { float x, y, z; };
} AngleValUnion_t;   // giống AngleUnion_t, giữ nguyên

typedef struct {
    Axis3fVal_t 		acceleration;        // giá trị float, không dùng pointer
    AngleValUnion_t 	angle;           // giá trị float
    AngularValUnion_t 	angular_rate;  // giá trị float
    RotationMatrix_t 	matrix;
} WORLD_t;
//
// ==== Low pass Filter ====
//
typedef struct {
    float alpha;       // α = T / (RC + T)
    float T;           // sampling period (s)
    float cf;          // cutoff frequency (Hz)
    float prev_out;    // y[n-1]
} LowPassFilter_t;
//
// ==== High pass Filter ====
//
typedef struct {
    float alpha;       // α = RC / (RC + T)
    float T;           // sampling period (s)
    float cf;          // cutoff frequency (Hz)
    float prev_in;     // x[n-1]
    float prev_out;    // y[n-1]
} HighPassFilter_t;
//
// ==== Complementary Filter ====
//
typedef struct {
    float alpha;
    LowPassFilter_t lowpass;
    HighPassFilter_t highpass;
    float *angle_out;
} COMFilter_t;
//
typedef struct
{
    uint32_t raw_Vbat;     // ADC_CHANNEL_0
    float    V_bat;       // Volt
} adc_data_t;

//
#define MAG_OX   (-5.8012f)
#define MAG_OY   ( 0.7941f)
#define MAG_OZ   (-38.1678f)

#define MAG_SX   (1.02f)
#define MAG_SY   (0.98f)
#define MAG_SZ   (1.01f)
// ==== Sensor Register Definitions ====
//
/* nRF24 commands */
#define NRF_CMD_R_REGISTER 0x00
#define NRF_CMD_W_REGISTER 0x20
#define NRF_CMD_FLUSH_TX 0xE1
#define NRF_CMD_FLUSH_RX 0xE2
#define NRF_CMD_NOP 0xFF
#define RF24_MAX_PAYLOAD 32

/* nRF24 registers */
#define CONFIG 0x00
#define EN_AA 0x01
#define EN_RXADDR 0x02
#define SETUP_RETR 0x04
#define RF_CH 0x05
#define RF_SETUP 0x06
#define STATUS 0x07
#define RX_ADDR_P0 0x0A
#define TX_ADDR 0x10
#define RX_PW_P0 0x11
#define CE_LOW()   HAL_GPIO_WritePin(RF24_CE_GPIO_Port, RF24_CE_Pin, GPIO_PIN_RESET)
#define CE_HIGH()  HAL_GPIO_WritePin(RF24_CE_GPIO_Port, RF24_CE_Pin, GPIO_PIN_SET)

#define CSN_LOW()    HAL_GPIO_WritePin(RF24_CSN_GPIO_Port, RF24_CSN_Pin, GPIO_PIN_RESET)
#define CSN_HIGH()   HAL_GPIO_WritePin(RF24_CSN_GPIO_Port, RF24_CSN_Pin, GPIO_PIN_SET)
/*****************************************************
 *                 BMP388 DEFINITIONS
 *****************************************************/
#define BMP388_ADDRESS                   (0x76 << 1)

/* Register Map */
#define BMP388_REG_DATA                  0x04
#define BMP388_REG_IF_CONF               0x1A
#define BMP388_REG_PWR_CTRL              0x1B
#define BMP388_REG_OSR                   0x1C
#define BMP388_REG_ODR                   0x1D
#define BMP388_REG_CONFIG                0x1F
#define BMP388_REG_CALIB_DATA            0x31
#define BMP388_REG_CMD                   0x7E

/* Default Configuration Values */
#define BMP388_REG_PWR_CTRL_VALUE        0x33
#define BMP388_REG_OSR_VALUE             0x03
#define BMP388_REG_ODR_VALUE             0x02
#define BMP388_REG_CONFIG_VALUE          0x02


/*****************************************************
 *                 BMM150 DEFINITIONS
 *****************************************************/
/* Overflow Values */
#define BMM150_XYAXES_FLIP_OVERFLOW_ADCVAL     ((int16_t)(-4096))
#define BMM150_ZAXIS_HALL_OVERFLOW_ADCVAL      ((int16_t)(-16384))

/* Saturation Limits (Z-Axis, µT scale) */
#define BMM150_OVERFLOW_ADCVAL_XYAXES_FLIP        INT16_C(-4096)
#define BMM150_OVERFLOW_ADCVAL_ZAXIS_HALL         INT16_C(-16384)
#define BMM150_OVERFLOW_OUTPUT                    INT16_C(-32768)
#define BMM150_NEGATIVE_SATURATION_Z              INT16_C(-32767)
#define BMM150_POSITIVE_SATURATION_Z              INT16_C(32767)
#define BMM150_OVERFLOW_OUTPUT_FLOAT              0.0f


/*****************************************************
 *                 BMX160 DEFINITIONS
 *****************************************************/
#define BMX160_ADDRESS                   (0x68 << 1)

/* Data Registers */
#define BMX160_REG_MAG_DATA_0            0x04

/* Configuration Registers */
#define BMX160_REG_ACCEL_CONFIG          0x40
#define BMX160_REG_ACCEL_RANGE           0x41
#define BMX160_REG_GYRO_CONFIG           0x42
#define BMX160_REG_GYRO_RANGE            0x43
#define BMX160_REG_MAGN_CONFIG           0x44

/* Magnetometer Interface Registers */
#define BMX160_REG_MAGN_RANGE            0x4B
#define BMX160_REG_MAGN_IF_0             0x4C
#define BMX160_REG_MAGN_IF_1             0x4D
#define BMX160_REG_MAGN_IF_2             0x4E
#define BMX160_REG_MAGN_IF_3             0x4F

/* Interrupt Configuration */
#define BMX160_REG_INT_ENABLE_1          0x51
#define BMX160_REG_INT_OUT_CTRL          0x53
#define BMX160_REG_INT_MAP_1             0x56

/* Offset & FOC Configuration */
#define BMX160_REG_FOC_CONF              0x69
#define BMX160_REG_CONF                  0x6A
#define BMX160_REG_OFFSET_6              0x77

/* Command Register */
#define BMX160_REG_COMMAND               0x7E


/*****************************************************
 *                 BMX160 DEFAULT VALUES
 *****************************************************/
/* Sensor Modes */
#define BMX160_CMD_ACCE_NORMAL_MODE      0x11
#define BMX160_CMD_GYRO_NORMAL_MODE      0x15
#define BMX160_CMD_MAG_NORMAL_MODE       0x19

/* Magnetometer Presets */
#define BMX160_MAG_HIGH_ACCURACY_PRESET_XY  0x17
#define BMX160_MAG_HIGH_ACCURACY_PRESET_Z   0x52

/* MAG_IF Data Mode (Indirect Access) */
#define BMX160_MAG_IF_0_DATA_MODE        0x03
#define BMX160_MAG_IF_1_DATA_MODE        0x42
#define BMX160_MAG_IF_2_DATA_MODE        0x4C
#define BMX160_MAG_IF_3_DATA_MODE        0x02

/* Sensitivity */
#define BMX160_ACCEL_OFFSET_SENSITIVITY  3.9e-3f   // mg/LSB
#define BMX160_GYRO_OFFSET_SENSITIVITY   0.061     // deg/s per LSB

/* Configuration Values  */
#define BMX160_REG_ACCEL_CONFIG_VALUE    0x28
#define BMX160_REG_ACCEL_RANGE_VALUE     0x03
#define BMX160_REG_GYRO_CONFIG_VALUE     0x28
#define BMX160_REG_GYRO_RANGE_VALUE      0x04
#define BMX160_REG_MAGN_CONFIG_VALUE     0x05
#define BMX160_REG_INT_ENABLE_1_VALUE    0x10
#define BMX160_REG_INT_OUT_CTRL_VALUE    0x08
#define BMX160_REG_INT_MAP_1_VALUE       0x80
#define BMX160_REG_FOC_CONF_VALUE        0x7D
#define BMX160_REG_OFFSET_6_VALUE        0xC0
#define BMX160_REG_MAGN_IF_0_VALUE       0x83


/*****************************************************
 *                 SYSTEM CONSTANTS
 *****************************************************/

#define TIM3_CLOCK						90000000
#define TIMING_BUDGET                    (10U)
#define SENSOR_BUF_LEN                   64
#define PWM_FORCE_US   1000.0f

/* Sensor Offsets and Lengths */
