#include "drone_controller.h"
#include "drone_sensor.h"
#include  "drone_settings.h"
#include "math.h"
void world_frame_update(WORLD_t *world_frame, BODY_t *body_frame) {

	float acc_roll = atan2f(*body_frame->acceleration.y,
			*body_frame->acceleration.z) * 180.0f / M_PI;

	float acc_pitch = atan2f(-*body_frame->acceleration.x,
			sqrtf(
					(*body_frame->acceleration.y)
							* (*body_frame->acceleration.y)
							+ (*body_frame->acceleration.z)
									* (*body_frame->acceleration.z)))
			* 180.0f/ M_PI;

	complementary_filter_update(&phi_filter,
			body_frame->angle.phi + (*body_frame->angular_rate.phi) * 1.0e-2f,
			acc_roll);

	complementary_filter_update(&theta_filter,
			body_frame->angle.theta
					+ (*body_frame->angular_rate.theta) * 1.0e-2f, acc_pitch);

	float phi = body_frame->angle.phi * M_PI / 180.0f;
	float theta = body_frame->angle.theta * M_PI / 180.0f;

	float mx = g_bmx160.mag_x;
	float my = g_bmx160.mag_y;
	float mz = g_bmx160.mag_z;

	float mx_h = mx * cosf(theta) + mz * sinf(theta);
	float my_h = mx * sinf(phi) * sinf(theta) + my * cosf(phi)
			- mz * sinf(phi) * cosf(theta);

	float yaw_mag = -atan2f(my_h, mx_h) * 180.0f / M_PI;

	float p = *body_frame->angular_rate.phi;
	float q = *body_frame->angular_rate.theta;
	float r = *body_frame->angular_rate.gamma;

	float ctheta = cosf(theta);
	if (fabsf(ctheta) < 0.01f)
		ctheta = 0.01f;

	float psi_dot = q * sinf(phi) / ctheta + r * cosf(phi) / ctheta;

	float yaw_gyro = body_frame->angle.gamma + psi_dot * 1.0e-2f;
	if (yaw_gyro < -180.0f) {
		yaw_gyro += 360;
	} else if (yaw_gyro > 180.0f) {
		yaw_gyro -= 360;
	};
	if (yaw_mag - yaw_gyro > 180.f) {
		yaw_mag -= 360;
	} else if (yaw_mag - yaw_gyro < -180.f) {
		yaw_mag += 360;
	};

	complementary_filter_update(&gamma_filter, yaw_gyro, yaw_mag);

	float gamma = body_frame->angle.gamma * M_PI / 180.0f;

	float cphi = cosf(phi), sphi = sinf(phi);
	float stheta = sinf(theta);
	float cgamma = cosf(gamma), sgamma = sinf(gamma);

	float *R = world_frame->matrix.accele_convert;

	R[0] = ctheta * cgamma;
	R[1] = sphi * stheta * cgamma - cphi * sgamma;
	R[2] = cphi * stheta * cgamma + sphi * sgamma;

	R[3] = ctheta * sgamma;
	R[4] = sphi * stheta * sgamma + cphi * cgamma;
	R[5] = cphi * stheta * sgamma - sphi * cgamma;

	R[6] = -stheta;
	R[7] = sphi * ctheta;
	R[8] = cphi * ctheta;

	world_frame->acceleration.x = R[0] * (*body_frame->acceleration.x)
			+ R[1] * (*body_frame->acceleration.y)
			+ R[2] * (*body_frame->acceleration.z);

	world_frame->acceleration.y = R[3] * (*body_frame->acceleration.x)
			+ R[4] * (*body_frame->acceleration.y)
			+ R[5] * (*body_frame->acceleration.z);

	world_frame->acceleration.z = R[6] * (*body_frame->acceleration.x)
			+ R[7] * (*body_frame->acceleration.y)
			+ R[8] * (*body_frame->acceleration.z);

	float ttheta = tanf(theta);

	world_frame->angular_rate.phi = p + q * sinf(phi) * ttheta
			+ r * cosf(phi) * ttheta;

	world_frame->angular_rate.theta = q * cosf(phi) - r * sinf(phi);

	world_frame->angular_rate.gamma = psi_dot;
}

void world_frame_init(WORLD_t *world_frame) {

	world_frame->acceleration.x = 0;
	world_frame->acceleration.y = 0;
	world_frame->acceleration.z = 0;

	world_frame->angle.phi = 0;
	world_frame->angle.theta = 0;

	world_frame->angular_rate.phi = 0;
	world_frame->angular_rate.theta = 0;
	world_frame->angular_rate.gamma = 0;

	for (int i = 0; i < 9; i++) {
		world_frame->matrix.accele_convert[i] = 0.0f;
		world_frame->matrix.angular_convert[i] = 0.0f;
	}
}

void lowpass_filter_init(LowPassFilter_t *lpf, float cf, float T) {
	lpf->cf = cf;
	lpf->T = T;
	float RC = 1.0f / (2.0f * (float) M_PI * cf);
	lpf->alpha = 1.0f - expf(-T / RC);   // hệ số tương đương
	lpf->prev_out = 0.0f;
}

float lowpass_filter_update(LowPassFilter_t *lpf, float input) {
	// y[n] = y[n-1] + alpha * (x[n] - y[n-1])
	float output = lpf->prev_out + lpf->alpha * (input - lpf->prev_out);
	lpf->prev_out = output;
	return output;
}

void highpass_filter_init(HighPassFilter_t *hpf, float cf, float T) {
	hpf->cf = cf;
	hpf->T = T;
	float RC = 1.0f / (2.0f * (float) M_PI * cf);
	hpf->alpha = expf(-T / RC);   // công thức tương đương dạng chính xác
	hpf->prev_in = 0.0f;
	hpf->prev_out = 0.0f;
}

float highpass_filter_update(HighPassFilter_t *hpf, float input) {
	// y[n] = alpha * (y[n-1] + x[n] - x[n-1])
	float out = hpf->alpha * (hpf->prev_out + input - hpf->prev_in);
	hpf->prev_in = input;
	hpf->prev_out = out;
	return out;
}

void complementary_filter_update(COMFilter_t *filter, float gyro_angle,
		float accle_angle) {
//    float lowpass_path  = lowpass_filter_update(&filter->lowpass, accle_angle);
//    float highpass_path = highpass_filter_update(&filter->highpass, gyro_angle);
	float result = filter->alpha * gyro_angle
			+ (1.0f - filter->alpha) * accle_angle;
	*(filter->angle_out) = result;
}

void complementary_filter_init(COMFilter_t *filter, float alpha, float cf_low,
		float cf_high, float T, float *angle_out_addr) {
	filter->alpha = alpha;
	filter->angle_out = angle_out_addr;   // trỏ đến nơi cần ghi kết quả

	highpass_filter_init(&filter->highpass, cf_high, T);
	lowpass_filter_init(&filter->lowpass, cf_low, T);
}
void drone_init(void) {
	rf24_init_tx_test();
	rf24_send_test();
	// === Gán con trỏ dữ liệu cảm biến ===
	body_frame.acceleration.x = &g_bmx160.accel_x;
	body_frame.acceleration.y = &g_bmx160.accel_y;
	body_frame.acceleration.z = &g_bmx160.accel_z;
	body_frame.angular_rate.x = &g_bmx160.gyro_x;
	body_frame.angular_rate.y = &g_bmx160.gyro_y;
	body_frame.angular_rate.z = &g_bmx160.gyro_z;

	// === Khởi tạo Complementary Filters ===
	complementary_filter_init(&phi_filter, phi_alpha, 10.0f, 0.0001f, 10.0e-3f,
			&body_frame.angle.phi);
	complementary_filter_init(&theta_filter, theta_alpha, 10.0f, 0.0001f,
			10.0e-3f, &body_frame.angle.theta);
	complementary_filter_init(&gamma_filter, gamma_alpha, 10.0f, 0.0001f,
			10.0e-3f, &body_frame.angle.gamma);
	// === Khởi động đo xung (TIM1 Input Capture) ===
	HAL_TIM_IC_Start_IT(htim3_receiver_pwm, RECEIVER_CH_1);
	HAL_TIM_IC_Start_IT(htim3_receiver_pwm, RECEIVER_CH_2);
	HAL_TIM_IC_Start_IT(htim3_receiver_pwm, RECEIVER_CH_3);
	HAL_TIM_IC_Start_IT(htim3_receiver_pwm, RECEIVER_CH_4);
	HAL_TIM_IC_Start_IT(htim5_encoder, RECEIVER_CH_5);
	// === Khởi động PWM (TIM2) ===
	HAL_TIM_PWM_Start(htim2_motor_pwm, MOTOR_CH_1);
	HAL_TIM_PWM_Start(htim2_motor_pwm, MOTOR_CH_2);
	HAL_TIM_PWM_Start(htim2_motor_pwm, MOTOR_CH_3);
	HAL_TIM_PWM_Start(htim2_motor_pwm, MOTOR_CH_4);

	HAL_TIM_IC_Start_DMA(htim5_encoder, ENCODER_CH, &rpm_buffer[0], 8);
	// === Khởi tạo cảm biến ===
	TIM2->CCR1 = (uint32_t) (2000 * (TIM3_CLOCK / 1e6f));
	TIM2->CCR2 = TIM2->CCR1;
	TIM2->CCR3 = TIM2->CCR1;
	TIM2->CCR4 = TIM2->CCR1;

	HAL_Delay(3000);   // đợi beep nhận max

	/* MIN throttle */
	TIM2->CCR1 = (uint32_t) (1000 * (TIM3_CLOCK / 1e6f));
	TIM2->CCR2 = TIM2->CCR1;
	TIM2->CCR3 = TIM2->CCR1;
	TIM2->CCR4 = TIM2->CCR1;

	HAL_Delay(6000);   // beep xác nhận calib

	/* IDLE an toàn */
	TIM2->CCR1 = (uint32_t) (1100 * (TIM3_CLOCK / 1e6f));
	TIM2->CCR2 = TIM2->CCR1;
	TIM2->CCR3 = TIM2->CCR1;
	TIM2->CCR4 = TIM2->CCR1;
	vl53cx_init();
	bmx160_init();
	bmp388_init();
	rf24_init();
	HAL_ADC_Start_DMA(hadc1_Vbat, &adc1_raw[0], 3);
	world_frame_init(&world_frame);

	HAL_Delay(1000);
}

