RANGING_SENSOR_ProfileConfig_t Profile;
RANGING_SENSOR_Result_t Result;
BMM150_TrimData trim_data;
BMP388_t g_bmp388;
BMX160_t g_bmx160;
adc_data_t adc1;

uint8_t sensor_buf[SENSOR_BUF_LEN];
uint8_t BMX160_arr[BMX160_LEN];
uint8_t sensor_data[52];
long VL53CX_DISTANCE;
PWM_out_t pwm_out;
COMFilter_t phi_filter;
COMFilter_t theta_filter;
COMFilter_t gamma_filter;
BODY_t body_frame;
WORLD_t world_frame;
float phi_alpha = 0.95;
float theta_alpha = 0.95;
float gamma_alpha = 0.99;
uint8_t flag_bmx_bmp_ready;
uint8_t flag_vl53_ready;
float check[6] = { 0 };

uint8_t channel_check[5] = { 0 };
uint16_t value1[5] = { 0 };
uint16_t value2[5] = { 0 };
float motor_rpm;
float V_bat;
uint32_t rpm_buffer[8] = { 0 };
uint32_t adc1_raw[3];
volatile uint8_t force_mode = 0;

void rf24_init_tx_test(void)
{
    uint8_t addr[5] = {0xE7,0xE7,0xE7,0xE7,0xE7};

    CE_LOW();
    HAL_Delay(5);

    rf24_write_reg(0x05, 76);    // RF_CH
    rf24_write_reg(0x06, 0x26);  // 250kbps, PA_LOW

    rf24_write_reg(0x01, 0x00);  // ❗ AUTO ACK OFF
    rf24_write_reg(0x02, 0x01);  // Enable RX pipe0
    rf24_write_reg(0x11, 10);    // Payload 10 byte

    rf24_write_reg(0x04, 0x00);  // ❗ NO RETRANSMIT
    rf24_write_reg(0x1D, 0x00);  // ❗ FEATURE OFF
    rf24_write_reg(0x1C, 0x00);  // ❗ DYNAMIC PAYLOAD OFF

    // TX_ADDR
    CSN_LOW();
    rf24_spi(0x20 | 0x10);
    for(int i=0;i<5;i++) rf24_spi(addr[i]);
    CSN_HIGH();

    // RX_ADDR_P0
    CSN_LOW();
    rf24_spi(0x20 | 0x0A);
    for(int i=0;i<5;i++) rf24_spi(addr[i]);
    CSN_HIGH();

    // CONFIG: PWR_UP + CRC_8 + TX
    rf24_write_reg(0x00, 0x0A);

    HAL_Delay(2);
}
void rf24_send_test(void)
{
	uint8_t payload[10] = {'H','E','L','L','O','_','R','F','!','!'};
	// Flush TX
	CSN_LOW();
	rf24_spi(0xE1);
	CSN_HIGH();

	// Write payload
	CSN_LOW();
	rf24_spi(0xA0);
	for(int i=0;i<10;i++) rf24_spi(payload[i]);
	CSN_HIGH();

	// CE pulse (CHUẨN)
	CE_HIGH();
	delay_us(15);
	CE_LOW();

	delay_us(200);


	rf24_write_reg(0x07, 0x70);
}


void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
{
	uint8_t ch;
	uint32_t tim_ch;
	uint32_t v;

	/* -------- Mapping channel -------- */
	if (htim->Instance == TIM5) {
		get_rpm(&rpm_buffer[4]);
		return;
	}

	if (htim->Instance == TIM1) {
		if      (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_1) { ch = 0; tim_ch = TIM_CHANNEL_1; }
		else if (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_2) { ch = 1; tim_ch = TIM_CHANNEL_2; }
		else if (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_3) { ch = 2; tim_ch = TIM_CHANNEL_3; }
		else if (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_4) { ch = 3; tim_ch = TIM_CHANNEL_4; }
		else return;
	}
	else if (htim->Instance == TIM3) {
		if (htim->Channel != HAL_TIM_ACTIVE_CHANNEL_1) return;
		ch = 4;
		tim_ch = TIM_CHANNEL_1;
	}
	else return;

	v = HAL_TIM_ReadCapturedValue(htim, tim_ch);

	/* -------- Rising / Falling -------- */
	if (!channel_check[ch]) {
		value1[ch] = v;
		channel_check[ch] = 1;
		return;
	}

	value2[ch] = v;
	channel_check[ch] = 0;

	/* -------- RAW pulse width (0..65535) -------- */
	uint32_t pulse = (value2[ch] - value1[ch]) & 0xFFFF;
	pwm_out.ccr[ch] = pulse;

	/* ================= CH4: MODE SWITCH ================= */
	if (ch == 4) {
		force_mode = (pulse < 7000);   // tuỳ ngưỡng
		return;
	}

	/* ================= chỉ CH1 quyết định output ================= */
	if (ch != 1)
		return;

	uint32_t out_ccr;

	if (force_mode) {
		out_ccr = 4200;   // ví dụ: 40000
	} else {
		out_ccr = pwm_out.ccr[1];
	}

	/* -------- Update TIM2 PWM -------- */
	TIM2->CCR1 = out_ccr;
	TIM2->CCR2 = out_ccr;
	TIM2->CCR3 = out_ccr;
	TIM2->CCR4 = out_ccr;
}


void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin) {
	if (GPIO_Pin == GPIO_PIN_7) {
		flag_vl53_ready = 1;

	}
}

void vl53cx_init(void) {
	CUSTOM_RANGING_SENSOR_Init(CUSTOM_VL53L3CX);
	Profile.RangingProfile = RS_MULTI_TARGET_MEDIUM_RANGE;
	Profile.TimingBudget = TIMING_BUDGET;
	Profile.Frequency = 0;
	Profile.EnableAmbient = 1;
	Profile.EnableSignal = 1;
	CUSTOM_RANGING_SENSOR_ConfigProfile(CUSTOM_VL53L3CX, &Profile);
	CUSTOM_RANGING_SENSOR_Start(CUSTOM_VL53L3CX, RS_MODE_ASYNC_CONTINUOUS);
}

void rf24_init(void) {
	uint8_t addr[5] = { 0xE7, 0xE7, 0xE7, 0xE7, 0xE7 };

	CE_LOW();
	HAL_Delay(5);

	rf24_write_reg(0x05, 110);    // RF_CH
	rf24_write_reg(0x06, 0x26);  // 250kbps, PA_LOW

	rf24_write_reg(0x01, 0x00);  // ❗ AUTO ACK OFF
	rf24_write_reg(0x02, 0x01);  // Enable RX pipe0
	rf24_write_reg(0x11, 32);    // Payload 10 byte

	rf24_write_reg(0x04, 0x00);  // ❗ NO RETRANSMIT
	rf24_write_reg(0x1D, 0x00);  // ❗ FEATURE OFF
	rf24_write_reg(0x1C, 0x00);  // ❗ DYNAMIC PAYLOAD OFF

	// TX_ADDR
	CSN_LOW();
	rf24_spi(0x20 | 0x10);
	for (int i = 0; i < 5; i++)
		rf24_spi(addr[i]);
	CSN_HIGH();

	// RX_ADDR_P0
	CSN_LOW();
	rf24_spi(0x20 | 0x0A);
	for (int i = 0; i < 5; i++)
		rf24_spi(addr[i]);
	CSN_HIGH();

	// CONFIG: PWR_UP + CRC_8 + TX
	rf24_write_reg(0x00, 0x0A);

	HAL_Delay(2);
}

void rf24_reinit(void) {
	uint8_t addr[5] = { 0xE7, 0xE7, 0xE7, 0xE7, 0xE7 };

	CE_LOW();
	HAL_Delay(2);

	// Power down
	rf24_write_reg(0x00, 0x00);
	HAL_Delay(2);

	// Flush FIFOs
	CSN_LOW();
	rf24_spi(0xE1);
	CSN_HIGH(); // FLUSH_TX
	CSN_LOW();
	rf24_spi(0xE2);
	CSN_HIGH(); // FLUSH_RX

	// Clear IRQ
	rf24_write_reg(0x07, 0x70);

	// RF setup
	rf24_write_reg(0x05, 76);
	rf24_write_reg(0x06, 0x26);

	// Address
	CSN_LOW();
	rf24_spi(0x20 | 0x10);
	for (int i = 0; i < 5; i++)
		rf24_spi(addr[i]);
	CSN_HIGH();

	// TX mode, CRC 8bit, PWR_UP
	rf24_write_reg(0x00, 0x0A);

	HAL_Delay(2);
}

void bmx160_init(void) {
	uint8_t cmd;
	cmd = 0xB6;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_COMMAND,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	HAL_Delay(1);
	cmd = BMX160_CMD_ACCE_NORMAL_MODE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_COMMAND,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	HAL_Delay(4);
	cmd = BMX160_CMD_GYRO_NORMAL_MODE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_COMMAND,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	HAL_Delay(80);
	uint8_t accel_cfg = BMX160_REG_ACCEL_CONFIG_VALUE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_ACCEL_CONFIG,
			I2C_MEMADD_SIZE_8BIT, &accel_cfg, 1, HAL_MAX_DELAY);
	accel_cfg = BMX160_REG_ACCEL_RANGE_VALUE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_ACCEL_RANGE,
			I2C_MEMADD_SIZE_8BIT, &accel_cfg, 1, HAL_MAX_DELAY);

	uint8_t gyro_cfg[2];
	gyro_cfg[0] = BMX160_REG_GYRO_CONFIG_VALUE;
	gyro_cfg[1] = BMX160_REG_GYRO_RANGE_VALUE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_GYRO_CONFIG,
			I2C_MEMADD_SIZE_8BIT, gyro_cfg, 2, HAL_MAX_DELAY);
	uint8_t int_cfg;
	int_cfg = BMX160_REG_INT_ENABLE_1_VALUE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_INT_ENABLE_1,
			I2C_MEMADD_SIZE_8BIT, &int_cfg, 1, HAL_MAX_DELAY);
	int_cfg = BMX160_REG_INT_OUT_CTRL_VALUE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_INT_OUT_CTRL,
			I2C_MEMADD_SIZE_8BIT, &int_cfg, 1, HAL_MAX_DELAY);
	int_cfg = BMX160_REG_INT_MAP_1_VALUE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_INT_MAP_1,
			I2C_MEMADD_SIZE_8BIT, &int_cfg, 1, HAL_MAX_DELAY);
	uint8_t foc_cfg = BMX160_REG_FOC_CONF_VALUE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_FOC_CONF,
			I2C_MEMADD_SIZE_8BIT, &foc_cfg, 1, HAL_MAX_DELAY);
	uint8_t offset6 = BMX160_REG_OFFSET_6_VALUE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_OFFSET_6,
			I2C_MEMADD_SIZE_8BIT, &offset6, 1, HAL_MAX_DELAY);

	cmd = BMX160_CMD_MAG_NORMAL_MODE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_COMMAND,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	HAL_Delay(50);
	cmd = BMX160_REG_MAGN_IF_0_VALUE + 3;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_MAGN_IF_0,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	HAL_Delay(50);

	bmm150_read_trim(&g_bmx160);

	cmd = 0x01;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_MAGN_IF_3,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	cmd = 0x4B;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_MAGN_IF_2,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	HAL_Delay(5);
	cmd = BMX160_MAG_HIGH_ACCURACY_PRESET_XY;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_MAGN_IF_3,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	cmd = 0x51;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_MAGN_IF_2,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	HAL_Delay(5);
	cmd = BMX160_MAG_HIGH_ACCURACY_PRESET_Z;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_MAGN_IF_3,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	cmd = 0x52;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_MAGN_IF_2,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	HAL_Delay(5);
	cmd = BMX160_MAG_IF_3_DATA_MODE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_MAGN_IF_3,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	cmd = BMX160_MAG_IF_2_DATA_MODE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_MAGN_IF_2,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	cmd = BMX160_MAG_IF_1_DATA_MODE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_MAGN_IF_1,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	cmd = BMX160_REG_MAGN_CONFIG_VALUE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_MAGN_CONFIG,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	cmd = BMX160_MAG_IF_0_DATA_MODE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_MAGN_IF_0,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	cmd = BMX160_CMD_MAG_NORMAL_MODE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_COMMAND,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	HAL_Delay(50);
	cmd = 0x03;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_COMMAND,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	HAL_Delay(50);
}

void bmm150_read(uint8_t reg, uint8_t *buf, uint8_t len) {
	HAL_I2C_Mem_Write(hi2c3_IMU, BMX160_ADDRESS,
	BMX160_REG_MAGN_IF_1,
	I2C_MEMADD_SIZE_8BIT, &reg, 1, HAL_MAX_DELAY);

	HAL_Delay(5);

	HAL_I2C_Mem_Read(hi2c3_IMU, BMX160_ADDRESS,
	BMX160_REG_MAG_DATA_0,
	I2C_MEMADD_SIZE_8BIT, buf, len, HAL_MAX_DELAY);
}

void bmm150_read_trim(BMX160_t *t) {
	BMM150_TrimData *tr = t->trim;
	uint8_t buf[2];

	// dig_x1, dig_y1
	bmm150_read(0x5D, buf, 2);
	tr->dig_x1 = (int8_t) buf[0];
	tr->dig_y1 = (int8_t) buf[1];

	// dig_z4
	bmm150_read(0x62, buf, 2);
	tr->dig_z4 = (int16_t) ((buf[1] << 8) | buf[0]);

	// dig_x2, dig_y2
	bmm150_read(0x64, buf, 2);
	tr->dig_x2 = (int8_t) buf[0];
	tr->dig_y2 = (int8_t) buf[1];

	// dig_z2
	bmm150_read(0x68, buf, 2);
	tr->dig_z2 = (int16_t) ((buf[1] << 8) | buf[0]);

	// dig_z1
	bmm150_read(0x6A, buf, 2);
	tr->dig_z1 = (uint16_t) ((buf[1] << 8) | buf[0]);

	// dig_xyz1
	bmm150_read(0x6C, buf, 2);
	tr->dig_xyz1 = (uint16_t) ((buf[1] << 8) | buf[0]);

	// dig_z3
	bmm150_read(0x6E, buf, 2);
	tr->dig_z3 = (int16_t) ((buf[1] << 8) | buf[0]);

	// dig_xy2, dig_xy1
	bmm150_read(0x70, buf, 2);
	tr->dig_xy2 = (int8_t) buf[0];
	tr->dig_xy1 = (int8_t) buf[1];
}

void decode_trim(uint8_t *DATA, BMX160_t *t) {
	BMM150_TrimData *trim = t->trim;

	trim->dig_x1 = (int8_t) DATA[0];                     // 0x5D
	trim->dig_y1 = (int8_t) DATA[1];                     // 0x5E
	// 0x5F–0x61: không dùng
	trim->dig_z4 = (int16_t) ((uint16_t) DATA[5] | ((uint16_t) DATA[6] << 8)); // 0x62–0x63
	trim->dig_x2 = (int8_t) DATA[7];                     // 0x64
	trim->dig_y2 = (int8_t) DATA[8];                     // 0x65
	// 0x66–0x67: không dùng
	trim->dig_z2 = (int16_t) ((uint16_t) DATA[11] | ((uint16_t) DATA[12] << 8)); // 0x68–0x69
	trim->dig_z1 =
			(uint16_t) ((uint16_t) DATA[13] | ((uint16_t) DATA[14] << 8)); // 0x6A–0x6B
	trim->dig_xyz1 = (uint16_t) ((uint16_t) DATA[15]
			| ((uint16_t) DATA[16] << 8)); // 0x6C–0x6D
	trim->dig_z3 = (int16_t) ((uint16_t) DATA[17] | ((uint16_t) DATA[18] << 8)); // 0x6E–0x6F
	trim->dig_xy2 = (int8_t) DATA[19];                    // 0x70
	trim->dig_xy1 = (int8_t) DATA[20];                    // 0x71
}

void bmx160_process_sensor_data_local(const uint8_t DATA[20], BMX160_t *bmx) {
	int16_t raw_x, raw_y, raw_z;
	uint16_t raw_rhall;

	/* X axis */
	uint8_t lsb_x = (DATA[0] & 0xF8) >> 3;   // chỉ lấy bit 7:3
	int8_t msb_x = (int8_t) DATA[1];          // full 8 bit có dấu
	raw_x = ((int16_t) (msb_x * 32)) | lsb_x; // <<5

	/* Y axis */
	uint8_t lsb_y = (DATA[2] & 0xF8) >> 3;
	int8_t msb_y = (int8_t) DATA[3];
	raw_y = ((int16_t) (msb_y * 32)) | lsb_y;

	/* Z axis */
	uint8_t lsb_z = (DATA[4] & 0xFE) >> 1;
	int8_t msb_z = (int8_t) DATA[5];
	raw_z = ((int16_t) (msb_z * 128)) | lsb_z;

	/* RHALL */
	uint8_t lsb_r = (DATA[6] & 0xFC) >> 2;
	uint8_t msb_r = DATA[7];
	raw_rhall = ((uint16_t) msb_r << 6) | lsb_r;

	int16_t comp_x = BMM150_OVERFLOW_OUTPUT;
	int16_t comp_y = BMM150_OVERFLOW_OUTPUT;
	int16_t comp_z = BMM150_OVERFLOW_OUTPUT;

	if (raw_x != BMM150_XYAXES_FLIP_OVERFLOW_ADCVAL) {
		uint16_t r =
				(raw_rhall != 0) ?
						raw_rhall :
						(bmx->trim->dig_xyz1 ? bmx->trim->dig_xyz1 : 0);
		if (r) {
			int16_t tmp = (int16_t) (((bmx->trim->dig_xyz1 * 16384) / r)
					- 0x4000);
			int32_t val = (((bmx->trim->dig_xy2 * tmp * tmp / 128)
					+ (tmp * bmx->trim->dig_xy1 * 128)) / 512 + 0x100000)
					* (bmx->trim->dig_x2 + 0xA0) / 4096;
			comp_x = (int16_t) ((raw_x * val / 8192 + bmx->trim->dig_x1 * 8)
					/ 16);
		}
	}
	if (raw_y != BMM150_XYAXES_FLIP_OVERFLOW_ADCVAL) {
		uint16_t r =
				(raw_rhall != 0) ?
						raw_rhall :
						(bmx->trim->dig_xyz1 ? bmx->trim->dig_xyz1 : 0);
		if (r) {
			int16_t tmp = (int16_t) (((bmx->trim->dig_xyz1 * 16384) / r)
					- 0x4000);
			int32_t val = (((bmx->trim->dig_xy2 * tmp * tmp / 128)
					+ (tmp * bmx->trim->dig_xy1 * 128)) / 512 + 0x100000)
					* (bmx->trim->dig_y2 + 0xA0) / 4096;
			comp_y = (int16_t) ((raw_y * val / 8192 + bmx->trim->dig_y1 * 8)
					/ 16);
		}
	}
	if (raw_z != BMM150_ZAXIS_HALL_OVERFLOW_ADCVAL) {
		if (bmx->trim->dig_z1 && bmx->trim->dig_z2 && bmx->trim->dig_xyz1
				&& raw_rhall != 0) {
			int32_t tmp = ((int32_t) raw_rhall - bmx->trim->dig_xyz1);
			int32_t val = (((int32_t) bmx->trim->dig_z3 * tmp) / 4);
			int32_t z = ((int32_t) (raw_z - bmx->trim->dig_z4) * 32768);
			int16_t tmp2 =
					(int16_t) ((bmx->trim->dig_z1 * raw_rhall * 2 + 32768)
							/ 65536);
			comp_z = (int16_t) ((z - val) / (bmx->trim->dig_z2 + tmp2) / 16);
			if (comp_z > BMM150_POSITIVE_SATURATION_Z)
				comp_z = BMM150_POSITIVE_SATURATION_Z;
			if (comp_z < BMM150_NEGATIVE_SATURATION_Z)
				comp_z = BMM150_NEGATIVE_SATURATION_Z;
		}
	}

	float mx, my, mz;

	/* compensate từ BMM150 (uT) */
	mx = comp_y;
	my = comp_x;
	mz = comp_z;

	/* HARD IRON */
	mx -= MAG_OX;
	my -= MAG_OY;
	mz -= MAG_OZ;

	/* SOFT IRON */
	mx *= MAG_SX;
	my *= MAG_SY;
	mz *= MAG_SZ;

	/* lưu lại */
	bmx->mag_x = mx;
	bmx->mag_y = my;
	bmx->mag_z = -mz;

	bmx->rhall = (float) raw_rhall;
	int16_t raw_gx = (int16_t) ((uint16_t) DATA[8] | ((uint16_t) DATA[9] << 8));
	int16_t raw_gy =
			(int16_t) ((uint16_t) DATA[10] | ((uint16_t) DATA[11] << 8));
	int16_t raw_gz =
			(int16_t) ((uint16_t) DATA[12] | ((uint16_t) DATA[13] << 8));
	int16_t raw_ax =
			(int16_t) ((uint16_t) DATA[14] | ((uint16_t) DATA[15] << 8));
	int16_t raw_ay =
			(int16_t) ((uint16_t) DATA[16] | ((uint16_t) DATA[17] << 8));
	int16_t raw_az =
			(int16_t) ((uint16_t) DATA[18] | ((uint16_t) DATA[19] << 8));

	bmx->gyro_y = (float) raw_gx * (3.8e-3f);
	bmx->gyro_x = (float) raw_gy * (3.8e-3f);
	bmx->gyro_z = -(float) raw_gz * (3.8e-3f);

	bmx->accel_y = -(float) raw_ax * 6.1e-5f * 9.8f;
	bmx->accel_x = -(float) raw_ay * 6.1e-5f * 9.8f;
	bmx->accel_z = (float) raw_az * 6.1e-5f * 9.8f;
}

void bmp388_process_sensor_data_local(const uint8_t DATA[6], BMP388_t *bmp) {
	// 1. Ghép dữ liệu raw 24-bit
	uint32_t p_raw = (DATA[0]) | (DATA[1] << 8) | (DATA[2] << 16);
	int32_t t_raw = (DATA[3]) | (DATA[4] << 8) | (DATA[5] << 16); // sign extend 24-bit

	// 2. Chuyển sang float
	float t_adc = (float) t_raw;
	float p_adc = (float) p_raw;

	// 3. Bù trừ nhiệt độ theo datasheet
	float partial_data1 = (t_adc - (float) bmp->calib.par_t1);
	float partial_data2 = partial_data1 * bmp->calib.par_t2;
	float temperature = partial_data2
			+ (partial_data1 * partial_data1) * bmp->calib.par_t3;

	// 4. Bù trừ áp suất theo datasheet
	float partial_data3 = bmp->calib.par_p6 * temperature;
	float partial_data4 = bmp->calib.par_p7 * temperature * temperature;
	float partial_data5 = bmp->calib.par_p8 * temperature * temperature
			* temperature;
	float partial_out1 = bmp->calib.par_p5 + partial_data3 + partial_data4
			+ partial_data5;

	float partial_data6 = bmp->calib.par_p2 * temperature;
	float partial_data7 = bmp->calib.par_p3 * temperature * temperature;
	float partial_data8 = bmp->calib.par_p4 * temperature * temperature
			* temperature;
	float partial_out2 =
			p_adc
					* (bmp->calib.par_p1 + partial_data6 + partial_data7
							+ partial_data8);

	float partial_out3 = p_adc * p_adc
			* (bmp->calib.par_p9 + bmp->calib.par_p10 * temperature);
	float pressure = partial_out1 + partial_out2 + partial_out3
			+ bmp->calib.par_p11 * p_adc * p_adc * p_adc;

	// 5. Lưu kết quả
	bmp->temperature = temperature;  // °C
	bmp->pressure = pressure;     // Pa
}

void process_bmx_bmp(void) {
	HAL_I2C_Mem_Read(hi2c3_IMU, BMX160_ADDRESS, BMX160_REG_MAG_DATA_0,
			I2C_MEMADD_SIZE_8BIT, &sensor_buf[BMX160_OFFSET], BMX160_LEN,
			HAL_MAX_DELAY);
	bmx160_process_sensor_data_local(&sensor_buf[BMX160_OFFSET], &g_bmx160);

	HAL_I2C_Mem_Read(hi2c3_IMU, BMP388_ADDRESS, BMP388_REG_DATA,
			I2C_MEMADD_SIZE_8BIT, &sensor_buf[BMP388_OFFSET], BMP388_LEN,
			HAL_MAX_DELAY);
	bmp388_process_sensor_data_local(&sensor_buf[BMP388_OFFSET], &g_bmp388);
}

void process_vl53cx_distance(void) {
	uint8_t j;

	if (CUSTOM_RANGING_SENSOR_GetDistance(CUSTOM_VL53L3CX, &Result) != 0) {

		return;   // lỗi I2C → giữ -1
	}

	for (j = 0; j < Result.ZoneResult[0].NumberOfTargets; j++) {
		if (Result.ZoneResult[0].Status[j] == 0) {
			VL53CX_DISTANCE = (long) Result.ZoneResult[0].Distance[j];
			break;
		}
	}
}

void bmp388_init(void) {
	uint8_t cmd;

	// 1. Set power control
	cmd = BMP388_REG_PWR_CTRL_VALUE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMP388_ADDRESS, BMP388_REG_PWR_CTRL,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	HAL_Delay(2);

	// 2. Set oversampling
	cmd = BMP388_REG_OSR_VALUE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMP388_ADDRESS, BMP388_REG_OSR,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	HAL_Delay(2);

	// 3. Set ODR
	cmd = BMP388_REG_ODR_VALUE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMP388_ADDRESS, BMP388_REG_ODR,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	HAL_Delay(2);

	// 4. Set config
	cmd = BMP388_REG_CONFIG_VALUE;
	HAL_I2C_Mem_Write(hi2c3_IMU, BMP388_ADDRESS, BMP388_REG_CONFIG,
			I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
	HAL_Delay(2);

	// 5. Read calibration data (21 bytes)
	HAL_I2C_Mem_Read(hi2c3_IMU, BMP388_ADDRESS, BMP388_REG_CALIB_DATA,
			I2C_MEMADD_SIZE_8BIT, &sensor_buf[0], 21, HAL_MAX_DELAY);

	uint16_t NVM_PAR_T1 = ((uint16_t) sensor_buf[1] << 8) | sensor_buf[0];
	uint16_t NVM_PAR_T2 = ((uint16_t) sensor_buf[3] << 8) | sensor_buf[2];
	int8_t NVM_PAR_T3 = sensor_buf[4];

	int16_t NVM_PAR_P1 = ((int16_t) sensor_buf[6] << 8) | sensor_buf[5];
	int16_t NVM_PAR_P2 = ((int16_t) sensor_buf[8] << 8) | sensor_buf[7];
	int8_t NVM_PAR_P3 = sensor_buf[9];
	int8_t NVM_PAR_P4 = sensor_buf[10];
	uint16_t NVM_PAR_P5 = ((uint16_t) sensor_buf[12] << 8) | sensor_buf[11];
	uint16_t NVM_PAR_P6 = ((uint16_t) sensor_buf[14] << 8) | sensor_buf[13];
	int8_t NVM_PAR_P7 = sensor_buf[15];
	int8_t NVM_PAR_P8 = sensor_buf[16];
	int16_t NVM_PAR_P9 = ((int16_t) sensor_buf[18] << 8) | sensor_buf[17];
	int8_t NVM_PAR_P10 = sensor_buf[19];
	int8_t NVM_PAR_P11 = sensor_buf[20];

	// 6. Compute actual calibration parameters (the formulas từ datasheet)
	g_bmp388.calib.par_t1 = NVM_PAR_T1 * 256.0f;          // 2^-8
	g_bmp388.calib.par_t2 = NVM_PAR_T2 / (float) (1UL << 30);
	g_bmp388.calib.par_t3 = NVM_PAR_T3 / (float) (1ULL << 48);

	g_bmp388.calib.par_p1 = (NVM_PAR_P1 - (1 << 14)) / (float) (1 << 20);
	g_bmp388.calib.par_p2 = (NVM_PAR_P2 - (1 << 14)) / (float) (1 << 29);
	g_bmp388.calib.par_p3 = NVM_PAR_P3 / (float) (1ULL << 32);        // 2^32
	g_bmp388.calib.par_p4 = NVM_PAR_P4 / (float) (1ULL << 37);
	g_bmp388.calib.par_p5 = NVM_PAR_P5 * 8.0f;            // 2^-3
	g_bmp388.calib.par_p6 = NVM_PAR_P6 / 64.0f;           // 2^6
	g_bmp388.calib.par_p7 = NVM_PAR_P7 / 256.0f;          // 2^8
	g_bmp388.calib.par_p8 = NVM_PAR_P8 / 32768.0f;        // 2^15
	g_bmp388.calib.par_p9 = NVM_PAR_P9 / (float) (1ULL << 48);
	g_bmp388.calib.par_p10 = NVM_PAR_P10 / (float) (1ULL << 48);
	g_bmp388.calib.par_p11 = NVM_PAR_P11 / 36893488147419103232.0f; // 2^65
}

uint8_t rf24_spi(uint8_t data) {
	uint8_t rx;
	HAL_StatusTypeDef ret;

	ret = HAL_SPI_TransmitReceive(&hspi1, &data, &rx, 1, 2);
	if (ret != HAL_OK) {
		HAL_SPI_Abort(&hspi1);
		__HAL_SPI_DISABLE(&hspi1);
		__HAL_SPI_ENABLE(&hspi1);
		rf24_init();

		return 0xFF;

	}
	return rx;
}

void rf24_write_reg(uint8_t reg, uint8_t val) {
	CSN_LOW();
	rf24_spi(0x20 | reg);
	rf24_spi(val);
	CSN_HIGH();
}

void delay_us(uint32_t us) {
	uint32_t start = DWT->CYCCNT;
	uint32_t ticks = us * (SystemCoreClock / 1000000);
	while ((DWT->CYCCNT - start) < ticks)
		;
}

uint8_t rf24_read_reg(uint8_t reg) {
	uint8_t val;
	CSN_LOW();
	rf24_spi(reg);
	val = rf24_spi(0xFF);
	CSN_HIGH();
	return val;
}

void rf24_send(uint8_t *data, uint8_t len) {
	// Flush TX
	CSN_LOW();
	rf24_spi(0xE1);      // FLUSH_TX
	CSN_HIGH();

	// Write payload
	CSN_LOW();
	rf24_spi(0xA0);      // W_TX_PAYLOAD
	for (uint8_t i = 0; i < len; i++) {
		rf24_spi(data[i]);
	}
	CSN_HIGH();

	// CE pulse (CHUẨN)
	CE_HIGH();
	delay_us(15);
	CE_LOW();

	// Đợi packet đi hết
	delay_us(200);

	// Clear IRQ flags (TX_DS | MAX_RT | RX_DR)
	rf24_write_reg(0x07, 0x70);
}

void send_all_sensor_packet_1(void) {
	uint8_t tx_buf[32];
	uint8_t i = 0;
	int16_t v16;

	/* ===== BMX160 accel ===== */
	v16 = (int16_t) (g_bmx160.accel_x * 1000.0f);
	tx_buf[i] = v16 >> 8;
	sensor_data[i] = tx_buf[i];
	i++;
	tx_buf[i] = v16;
	sensor_data[i] = tx_buf[i];
	i++;

	v16 = (int16_t) (g_bmx160.accel_y * 1000.0f);
	tx_buf[i] = v16 >> 8;
	sensor_data[i] = tx_buf[i];
	i++;
	tx_buf[i] = v16;
	sensor_data[i] = tx_buf[i];
	i++;

	v16 = (int16_t) (g_bmx160.accel_z * 1000.0f);
	tx_buf[i] = v16 >> 8;
	sensor_data[i] = tx_buf[i];
	i++;
	tx_buf[i] = v16;
	sensor_data[i] = tx_buf[i];
	i++;

	/* ===== BMX160 gyro ===== */
	v16 = (int16_t) (g_bmx160.gyro_x * 1000.0f);
	tx_buf[i] = v16 >> 8;
	sensor_data[i] = tx_buf[i];
	i++;
	tx_buf[i] = v16;
	sensor_data[i] = tx_buf[i];
	i++;

	v16 = (int16_t) (g_bmx160.gyro_y * 1000.0f);
	tx_buf[i] = v16 >> 8;
	sensor_data[i] = tx_buf[i];
	i++;
	tx_buf[i] = v16;
	sensor_data[i] = tx_buf[i];
	i++;

	v16 = (int16_t) (g_bmx160.gyro_z * 1000.0f);
	tx_buf[i] = v16 >> 8;
	sensor_data[i] = tx_buf[i];
	i++;
	tx_buf[i] = v16;
	sensor_data[i] = tx_buf[i];
	i++;

	/* ===== BMX160 mag ===== */
	v16 = (int16_t) (body_frame.angle.phi * 100.0f);
	tx_buf[i] = v16 >> 8;
	sensor_data[i] = tx_buf[i];
	i++;
	tx_buf[i] = v16;
	sensor_data[i] = tx_buf[i];
	i++;

	v16 = (int16_t) (body_frame.angle.theta * 100.0f);
	tx_buf[i] = v16 >> 8;
	sensor_data[i] = tx_buf[i];
	i++;
	tx_buf[i] = v16;
	sensor_data[i] = tx_buf[i];
	i++;

	v16 = (int16_t) (body_frame.angle.gamma * 100.0f);
	tx_buf[i] = v16 >> 8;
	sensor_data[i] = tx_buf[i];
	i++;
	tx_buf[i] = v16;
	sensor_data[i] = tx_buf[i];
	i++;

	/* ===== WORLD accel ===== */
	v16 = (int16_t) (world_frame.acceleration.x * 1000.0f);
	tx_buf[i] = v16 >> 8;
	sensor_data[i] = tx_buf[i];
	i++;
	tx_buf[i] = v16;
	sensor_data[i] = tx_buf[i];
	i++;

	v16 = (int16_t) (world_frame.acceleration.y * 1000.0f);
	tx_buf[i] = v16 >> 8;
	sensor_data[i] = tx_buf[i];
	i++;
	tx_buf[i] = v16;
	sensor_data[i] = tx_buf[i];
	i++;

	v16 = (int16_t) (world_frame.acceleration.z * 1000.0f);
	tx_buf[i] = v16 >> 8;
	sensor_data[i] = tx_buf[i];
	i++;
	tx_buf[i] = v16;
	sensor_data[i] = tx_buf[i];
	i++;

	/* ===== WORLD angular rate ===== */
	v16 = (int16_t) (world_frame.angular_rate.x * 1000.0f);
	tx_buf[i] = v16 >> 8;
	sensor_data[i] = tx_buf[i];
	i++;
	tx_buf[i] = v16;
	sensor_data[i] = tx_buf[i];
	i++;

	v16 = (int16_t) (world_frame.angular_rate.y * 1000.0f);
	tx_buf[i] = v16 >> 8;
	sensor_data[i] = tx_buf[i];
	i++;
	tx_buf[i] = v16;
	sensor_data[i] = tx_buf[i];
	i++;

	v16 = (int16_t) (world_frame.angular_rate.z * 1000.0f);
	tx_buf[i] = v16 >> 8;
	sensor_data[i] = tx_buf[i];
	i++;
	tx_buf[i] = v16;
	sensor_data[i] = tx_buf[i];
	i++;

	/* ===== VL53CX distance ===== */
	int16_t dist16 = (int16_t) VL53CX_DISTANCE;

	tx_buf[i++] = (dist16 >> 8) & 0xFF;
	tx_buf[i++] = (dist16 >> 0) & 0xFF;
	/* ===== GỬI NRF24 ===== */
	CSN_LOW();
	rf24_spi(0xE1);        // FLUSH_TX
	CSN_HIGH();

	CSN_LOW();
	rf24_spi(0xA0);        // W_TX_PAYLOAD
	for (uint8_t k = 0; k < 32; k++)
		rf24_spi(tx_buf[k]);
	CSN_HIGH();

	CE_HIGH();
	delay_us(15);
	CE_LOW();

	rf24_write_reg(0x07, 0x70);  // clear IRQ
}

void send_all_sensor_packet_2(void) {
	uint8_t tx_buf[32] = { 0 };
	uint8_t i = 0;

	/* ===== HEADER 2 BYTE ===== */
	tx_buf[i++] = 0xFF;
	tx_buf[i++] = 0xFF;

	/* ===== PACK FLOAT PWM (us) ===== */
	union {
		float f;
		uint8_t b[4];
	} u;

	u.f = pwm_out.width_us[1];

	tx_buf[i++] = u.b[0];
	tx_buf[i++] = u.b[1];
	tx_buf[i++] = u.b[2];
	tx_buf[i++] = u.b[3];

	/* ===== SEND NRF24 ===== */
	CSN_LOW();
	rf24_spi(0xE1);        // FLUSH_TX
	CSN_HIGH();

	CSN_LOW();
	rf24_spi(0xA0);        // W_TX_PAYLOAD
	for (uint8_t k = 0; k < 32; k++)
		rf24_spi(tx_buf[k]);   // vẫn gửi đủ 32 byte
	CSN_HIGH();

	CE_HIGH();
	delay_us(15);
	CE_LOW();

	rf24_write_reg(0x07, 0x70); // clear IRQ
}

void HAL_TIM_IC_CaptureHalfCpltCallback(TIM_HandleTypeDef *htim) {
	if (htim->Instance == TIM5) {
		// Log overcapture
		if (__HAL_TIM_GET_FLAG(htim, TIM_FLAG_CC1OF)) {
			check[5]++;                 // đếm số lần overcapture
			__HAL_TIM_CLEAR_FLAG(htim, TIM_FLAG_CC1OF);
		}
		get_rpm(&motor_buffer[0]);
	}
	check[1] += 4;

}

void get_rpm(uint32_t *motor_buffer) {

	float total = 0.0f;
	for (uint8_t i = 0; i < 3; i++) {
		total += (uint32_t) motor_buffer[1 + i] - motor_buffer[i];
	}
	float timer_freq = (float) TIM1_CLOCK / (float) 70.0f;

	motor_rpm = timer_freq * 60.0f * 3.0f / total;
}
void adc_Process(const uint32_t *raw, adc_data_t *out)
{
    /* Map raw */
    out->raw_Vbat  = raw[0];
    out->raw_temp = raw[1];
    out->raw_vref = raw[2];

    /* ===== VDDA (mV) ===== */
    out->vdda_mv =
        (VREFINT_CAL_VREF * (*VREFINT_CAL_ADDR)) / out->raw_vref;

    /* ===== Temperature (°C) ===== */
    out->temp_c =
    (
        ((int32_t)out->raw_temp - (int32_t)(*TEMPSENSOR_CAL1_ADDR)) *
        (TEMPSENSOR_CAL2_TEMP - TEMPSENSOR_CAL1_TEMP)
    )
    /
    (
        (int32_t)(*TEMPSENSOR_CAL2_ADDR - *TEMPSENSOR_CAL1_ADDR)
    )
    + TEMPSENSOR_CAL1_TEMP;

    /* ===== Battery Voltage (V) ===== */
    float vbat_inst =
        ((float)out->raw_Vbat / 65535.0f) *
        ((float)out->vdda_mv / 1000.0f) *
        ((131.0f + 31.8f) / 31.8f);

    /* ===== LPF ===== */
    out->V_bat = 0.1f * vbat_inst + 0.9f * V_bat;
}

