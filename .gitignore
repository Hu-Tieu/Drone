# ignore everything
*

# allow gitignore itself
!.gitignore

# allow folders so git có thể đi vào
!Core/
!Core/App/
!Core/App/**
!Core/Drivers/
!Core/Drivers/**

# allow main
!Core/Src/
!Core/Src/main.c

!Core/Inc/
!Core/Inc/main.h

# mở Drivers từng cấp
!Drivers/
!Drivers/BSP/
!Drivers/BSP/Components/
!Drivers/BSP/Components/vl53l3cx/
!Drivers/BSP/Components/vl53l3cx/**